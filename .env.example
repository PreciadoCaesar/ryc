# ---- APPLICATION ----
APP_NAME="R&C Consulting"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

# ---- DATABASE (MySQL / XAMPP) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ryc
DB_USERNAME=root
DB_PASSWORD=

# ---- CACHE / SESSION / QUEUE ----
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# ---- MAIL (purchase confirmations) ----
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@rc-consulting.org
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@rc-consulting.org"
MAIL_FROM_NAME="${APP_NAME}"

# ---- GOOGLE OAUTH 2.0 (Laravel Socialite) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/auth/google/callback

# ---- IZIPAY - Payment Gateway ----
IZIPAY_ENV=sandbox
IZIPAY_ENDPOINT=https://api.micuentaweb.pe
IZIPAY_USERNAME=
IZIPAY_PASSWORD=
IZIPAY_PUBLIC_KEY=
IZIPAY_SHA256_KEY=

# ---- WHATSAPP (default advisor number) ----
WHATSAPP_PHONE=51950883155

# ---- LOG ----
LOG_STACK=daily
LOG_LEVEL=debug
LOG_CHANNEL=daily

# ---- BCRYPT ----
BCRYPT_ROUNDS=12

# ---- FILESYSTEMS ----
FILESYSTEM_DISK=local

# ---- BROADCASTING ----
BROADCAST_CONNECTION=log
