	<style>
	.popup-compras {
		position: fixed;
		bottom: 30px;
		right: 30px;
		background: linear-gradient(135deg, #0A1F5C 0%, #1a3a7a 100%);
		border-radius: 20px;
		box-shadow: 
			0 15px 50px rgba(10, 31, 92, 0.35),
			0 5px 20px rgba(0, 0, 0, 0.2),
			inset 0 1px 0 rgba(255, 255, 255, 0.1);
		padding: 20px 24px;
		max-width: 320px;
		z-index: 99999;
		font-family: 'Poppins', sans-serif;
		display: block;
		opacity: 0;
		visibility: hidden;
		border: 1px solid rgba(255, 255, 255, 0.1);
	}
	@keyframes popupCompraEntra {
		from { transform: translateY(30px) scale(0.95); opacity: 0; }
		to { transform: translateY(0) scale(1); opacity: 1; }
	}
	@keyframes popupCompraSale {
		from { transform: translateY(0) scale(1); opacity: 1; }
		to { transform: translateY(20px) scale(0.95); opacity: 0; }
	}
	.popup-compras.show { 
		display: block; 
		opacity: 1;
		visibility: visible;
		animation: popupCompraEntra 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
	}
	.popup-compras.ocultar {
		animation: popupCompraSale 0.4s ease forwards;
	}
	.popup-compras .contenido {
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.popup-compras .icono { 
		font-size: 22px; 
		color: #FFD700;
		background: rgba(255, 215, 0, 0.15);
		width: 50px;
		height: 50px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		border: 2px solid rgba(255, 215, 0, 0.3);
	}
	.popup-compras .icono i {
		filter: drop-shadow(0 0 5px rgba(255, 215, 0, 0.5));
	}
	.popup-compras .texto {
		flex: 1;
		min-width: 0;
	}
	.popup-compras .nombre { 
		font-weight: 700; 
		color: #ffffff; 
		font-size: 14px;
		line-height: 1.3;
		margin-bottom: 4px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.popup-compras .curso { 
		color: rgba(255, 255, 255, 0.85); 
		font-size: 13px; 
		font-weight: 400;
		line-height: 1.3;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.popup-compras .badge {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		background: rgba(255, 215, 0, 0.15);
		color: #FFD700;
		padding: 6px 12px;
		border-radius: 30px;
		font-size: 11px;
		font-weight: 600;
		margin-top: 10px;
		border: 1px solid rgba(255, 215, 0, 0.2);
	}
	.popup-compras .badge i {
		font-size: 10px;
	}
	.popup-compras .cerrar {
		position: absolute;
		top: 8px;
		right: 10px;
		cursor: pointer;
		color: rgba(255, 255, 255, 0.4);
		font-size: 18px;
		line-height: 1;
		transition: all 0.3s;
		width: 24px;
		height: 24px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
	}
	.popup-compras .cerrar:hover {
		color: #fff;
		background: rgba(255, 255, 255, 0.1);
		transform: rotate(90deg);
	}
	.viewing-count {
		position: absolute;
		top: 10px;
		left: 10px;
		background: rgba(0,0,0,.7);
		color: #fff;
		padding: 4px 10px;
		border-radius: 20px;
		font-size: 11px;
		font-weight: 600;
		display: flex;
		align-items: center;
		gap: 5px;
		z-index: 15;
	}
	.viewing-count::before {
		content: '';
		width: 8px;
		height: 8px;
		background: #4CAF50;
		border-radius: 50%;
		animation: blink 1s infinite;
	}
	@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: .4; } }
	
	/* MODAL OFERTA ESTILO TEMU ANIMACIONES + COLORES R&C */
	@keyframes temuPop {
		0% { transform: scale(0.8); opacity: 0; }
		100% { transform: scale(1); opacity: 1; }
	}
	@keyframes temuShake {
		0%, 100% { transform: translateX(0); }
		10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
		20%, 40%, 60%, 80% { transform: translateX(5px); }
	}
	@keyframes temuPulse {
		0%, 100% { transform: scale(1); }
		50% { transform: scale(1.05); }
	}
	@keyframes temuGlow {
		0%, 100% { box-shadow: 0 0 20px rgba(10, 31, 92, 0.3); }
		50% { box-shadow: 0 0 40px rgba(10, 31, 92, 0.6), 0 0 60px rgba(200, 16, 46, 0.3); }
	}
	@keyframes floatIcon {
		0%, 100% { transform: translateY(0) rotate(0deg) scale(1); }
		25% { transform: translateY(-15px) rotate(-8deg) scale(1.1); }
		50% { transform: translateY(0) rotate(0deg) scale(1); }
		75% { transform: translateY(10px) rotate(8deg) scale(0.95); }
	}
	@keyframes shakeIcon {
		0%, 100% { transform: rotate(0deg); }
		25% { transform: rotate(-15deg); }
		75% { transform: rotate(15deg); }
	}
	.icono-oferta-flotante {
		position: fixed;
		top: 100px;
		right: 20px;
		width: 70px;
		height: 70px;
		background: linear-gradient(135deg, #0A1F5C 0%, #03206A 100%);
		border-radius: 50%;
		display: none;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		z-index: 9998;
		box-shadow: 0 10px 30px rgba(10, 31, 92, 0.4);
		animation: temuPop 0.4s ease forwards, floatIcon 2s ease-in-out infinite 0.5s;
		border: 3px solid #fff;
	}
	.icono-oferta-flotante:hover {
		animation: temuPop 0.2s ease;
	}
	.icono-oferta-flotante::before {
		content: '';
		position: absolute;
		width: 100%;
		height: 100%;
		border-radius: 50%;
		background: linear-gradient(135deg, #C8102E, #0A1F5C);
		z-index: -1;
		animation: temuPulse 2s ease-in-out infinite;
	}
	.icono-oferta-flotante i {
		font-size: 30px;
		color: #fff;
		text-shadow: 0 2px 10px rgba(0,0,0,0.3);
	}
	.icono-oferta-flotante .badge-descuento {
		position: absolute;
		top: -5px;
		right: -5px;
		background: #C8102E;
		color: #fff;
		font-size: 11px;
		font-weight: 800;
		padding: 4px 8px;
		border-radius: 20px;
		font-family: 'Montserrat', sans-serif;
		animation: temuPulse 1.5s ease-in-out infinite;
	}
	.modal-oferta-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(10, 31, 92, 0.95);
		z-index: 99999;
		display: none;
		justify-content: center;
		align-items: center;
		opacity: 0;
		transition: opacity 0.3s ease;
	}
	.modal-oferta-overlay.active {
		display: flex;
		opacity: 1;
		animation: temuShake 0.5s ease;
	}
	.modal-oferta-content {
		background: linear-gradient(145deg, #ffffff 0%, #f5f7fa 100%);
		border-radius: 20px;
		padding: 40px;
		max-width: 800px;
		width: 95%;
		position: relative;
		box-shadow: 0 25px 80px rgba(0,0,0,0.4);
		border: 3px solid #0A1F5C;
		animation: temuPop 0.5s ease;
	}
	.modal-oferta-cerrar {
		position: absolute;
		top: 15px;
		right: 20px;
		font-size: 28px;
		color: #0A1F5C;
		cursor: pointer;
		transition: transform 0.3s ease;
		z-index: 10;
	}
	.modal-oferta-cerrar:hover {
		transform: rotate(90deg) scale(1.2);
		color: #C8102E;
	}
	.modal-oferta-titulo {
		text-align: center;
		margin-bottom: 30px;
	}
	.modal-oferta-titulo h2 {
		font-family: 'Poppins', sans-serif;
		font-size: 28px;
		font-weight: 800;
		color: #0A1F5C;
		margin-bottom: 8px;
	}
	.modal-oferta-titulo p {
		font-family: 'Poppins', sans-serif;
		font-size: 14px;
		color: #666;
	}
	.modal-oferta-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 15px;
		max-height: 350px;
		overflow-y: auto;
		padding: 10px;
	}
	.modal-curso-item {
		background: #fff;
		border: 2px solid #e0e0e0;
		border-radius: 12px;
		padding: 15px;
		cursor: pointer;
		transition: all 0.3s ease;
		text-align: center;
	}
	.modal-curso-item:hover {
		border-color: #0A1F5C;
		transform: translateY(-5px);
		box-shadow: 0 10px 30px rgba(10, 31, 92, 0.2);
		animation: temuGlow 1s ease-in-out infinite;
	}
	.modal-curso-item:hover .curso-nombre {
		color: #C8102E;
		font-weight: 700;
	}
	.modal-curso-item .curso-nombre {
		font-family: 'Montserrat', sans-serif;
		font-size: 13px;
		font-weight: 600;
		color: #0A1F5C;
		margin-bottom: 5px;
	}
	.modal-curso-item .curso-tag {
		font-size: 11px;
		color: #C8102E;
		font-weight: 700;
		opacity: 0;
		transition: opacity 0.3s ease;
	}
	.modal-curso-item:hover .curso-tag {
		opacity: 1;
	}
	.modal-oferta-resultado {
		display: none;
		text-align: center;
		padding: 20px;
	}
	.modal-oferta-resultado.mostrar {
		display: block;
		animation: temuPop 0.5s ease;
	}
	.modal-oferta-codigo {
		background: linear-gradient(135deg, #0A1F5C, #03206A);
		color: #fff;
		padding: 20px 40px;
		border-radius: 12px;
		display: inline-block;
		margin: 20px 0;
		font-family: 'Montserrat', sans-serif;
	}
	.modal-oferta-codigo span {
		display: block;
		font-size: 12px;
		opacity: 0.8;
		margin-bottom: 5px;
	}
	.modal-oferta-codigo strong {
		font-size: 28px;
		letter-spacing: 3px;
		color: #FFD700;
		text-shadow: 0 0 20px rgba(255, 215, 0, 0.5);
	}
	.modal-oferta-btn {
		background: linear-gradient(135deg, #25D366 0%, #20b858 100%);
		color: #fff;
		border: none;
		padding: 16px 40px;
		font-size: 16px;
		font-weight: 700;
		border-radius: 50px;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		transition: all 0.3s ease;
		box-shadow: 0 5px 20px rgba(37, 211, 102, 0.4);
		font-family: 'Poppins', sans-serif;
	}
	.modal-oferta-btn:hover {
		transform: scale(1.05);
		box-shadow: 0 8px 30px rgba(37, 211, 102, 0.6);
	}
	.modal-oferta-aviso {
		font-size: 11px;
		color: #888;
		margin-top: 15px;
		font-family: 'Poppins', sans-serif;
	}
	
	/* OVERLAY Y CONTENEDOR DE CURSOS CON HOVER */
	.overlay-oferta {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.8);
		z-index: 99990;
		display: none;
		opacity: 0;
		transition: opacity 0.3s ease;
	}
	.overlay-oferta.active {
		display: block;
		opacity: 1;
	}
	.cursos-hover-container {
		position: fixed;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%) scale(0.9);
		z-index: 99991;
		display: none;
		opacity: 0;
		transition: transform 0.3s ease, opacity 0.3s ease;
		width: 90%;
		max-width: 900px;
	}
	.cursos-hover-container::before {
		content: '';
		position: absolute;
		top: -20px;
		left: -20px;
		right: -20px;
		bottom: -20px;
		background: linear-gradient(45deg, transparent 30%, rgba(255,215,0,0.6) 50%, transparent 70%);
		background-size: 200% 200%;
		animation: estelaAmarilla 2s linear;
		border-radius: 25px;
		z-index: -1;
		filter: blur(15px);
		opacity: 0;
		transition: opacity 0.3s ease;
	}
	.cursos-hover-container.active::before {
		opacity: 1;
	}
	.cursos-hover-container.active.con-estela::before {
		animation: estelaAmarilla 2s linear;
	}
	@keyframes estelaAmarilla {
		0% { background-position: 200% 50%; }
		100% { background-position: -200% 50%; }
	}
	.cursos-hover-container.active {
		display: block;
		opacity: 1;
		transform: translate(-50%, -50%) scale(1);
	}
	.cursos-hover-titulo {
		text-align: center;
		margin-bottom: 25px;
	}
	.cursos-hover-titulo h3 {
		font-family: 'Poppins', sans-serif;
		font-size: 24px;
		font-weight: 800;
		color: #fff;
		text-shadow: 0 2px 10px rgba(0,0,0,0.3);
	}
	.cursos-hover-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 15px;
		max-height: 55vh;
		overflow-y: auto;
		padding: 20px;
		background: rgba(255,255,255,0.15);
		border-radius: 15px;
	}
	@media(max-width:768px){
		.cursos-hover-grid { grid-template-columns: repeat(2, 1fr); }
	}
	@media(max-width:480px){
		.cursos-hover-grid { grid-template-columns: 1fr; }
	}
	.curso-hover-item {
		position: relative;
		background: #fff;
		border-radius: 12px;
		overflow: hidden;
		cursor: pointer;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.curso-hover-item:hover {
		transform: translateY(-5px);
		box-shadow: 0 10px 20px rgba(10, 31, 92, 0.25);
	}
	.curso-hover-item img {
		width: 100%;
		height: 140px;
		object-fit: contain;
		object-position: center;
		background: #f5f5f5;
	}
	.curso-hover-item:hover img {
		transform: none;
	}
	.curso-hover-info {
		padding: 12px;
		background: linear-gradient(to top, #fff 0%, #f8f9fa 100%);
	}
	.curso-hover-info h4 {
		font-family: 'Montserrat', sans-serif;
		font-size: 12px;
		font-weight: 800;
		color: #0A1F5C;
		margin-bottom: 4px;
		line-height: 1.2;
	}
	.curso-hover-info .fecha {
		font-size: 11px;
		color: #666;
		font-weight: 500;
	}
	.curso-hover-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, rgba(10, 31, 92, 0.9), rgba(200, 16, 46, 0.8));
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity 0.3s ease;
	}
	.curso-hover-item:hover .curso-hover-overlay {
		opacity: 1;
	}
	.curso-hover-overlay span {
		color: #fff;
		font-family: 'Montserrat', sans-serif;
		font-size: 11px;
		font-weight: 800;
		text-transform: uppercase;
	}
	
	/* MODAL RESULTADO FIJO */
	.modal-oferta-resultado-fijo {
		position: fixed;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%) scale(0.8);
		z-index: 99992;
		display: none;
		opacity: 0;
		transition: transform 0.3s ease, opacity 0.3s ease;
	}
	.modal-oferta-resultado-fijo.active {
		display: block;
		opacity: 1;
		transform: translate(-50%, -50%) scale(1);
	}
	.modal-resultado-content {
		background: #0A1F5C;
		border-radius: 15px;
		padding: 35px;
		text-align: center;
		box-shadow: 0 20px 60px rgba(0,0,0,0.4);
		border: 2px solid #fff;
		max-width: 380px;
		position: relative;
		overflow: hidden;
	}
	.resultado-contenido {
		display: none;
		opacity: 0;
		transition: opacity 0.2s ease;
	}
	.resultado-contenido.mostrar {
		display: block;
		opacity: 1;
	}
	.cerrar-resultado {
		position: absolute;
		top: 15px;
		right: 20px;
		font-size: 28px;
		color: #fff;
		cursor: pointer;
		transition: transform 0.2s;
	}
	.cerrar-resultado:hover {
		transform: rotate(90deg) scale(1.2);
		color: #FFD700;
	}
	.resultado-icono {
		width: 80px;
		height: 80px;
		background: #fff;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 20px;
		box-shadow: 0 5px 20px rgba(0,0,0,0.3);
	}
	.resultado-icono i {
		font-size: 35px;
		color: #0A1F5C;
	}
	.modal-resultado-content h2 {
		font-family: 'Poppins', sans-serif;
		font-size: 22px;
		font-weight: 800;
		color: #fff;
		margin-bottom: 5px;
	}
	.modal-resultado-content p {
		font-size: 13px;
		color: rgba(255,255,255,0.8);
		margin-bottom: 20px;
	}
	.codigo-box {
		background: #03206A;
		padding: 20px;
		border-radius: 10px;
		margin-bottom: 20px;
		border: 1px solid rgba(255,255,255,0.2);
	}
	.codigo-box span {
		display: block;
		font-size: 11px;
		color: rgba(255,255,255,0.7);
		margin-bottom: 5px;
		font-family: 'Poppins', sans-serif;
		text-transform: uppercase;
		letter-spacing: 1px;
	}
	.codigo-box strong {
		font-size: 28px;
		color: #FFD700;
		letter-spacing: 4px;
		text-shadow: 0 0 25px rgba(255, 215, 0, 0.7);
	}
	.btn-whatsapp-oferta {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		background: linear-gradient(135deg, #25D366, #20b858);
		color: #fff;
		padding: 14px 30px;
		border-radius: 50px;
		font-weight: 700;
		text-decoration: none;
		font-size: 15px;
		transition: all 0.3s ease;
		box-shadow: 0 5px 20px rgba(37, 211, 102, 0.4);
	}
	.btn-whatsapp-oferta:hover {
		transform: scale(1.05);
		box-shadow: 0 8px 30px rgba(37, 211, 102, 0.6);
	}
	.btn-unico-oferta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		background: #C8102E;
		color: #fff;
		padding: 14px 30px;
		border-radius: 8px;
		font-weight: 700;
		text-decoration: none;
		font-size: 14px;
		transition: transform 0.2s ease, background 0.2s ease;
	}
	.btn-unico-oferta:hover {
		transform: scale(1.03);
		background: #a00d24;
	}
	@keyframes botonPulse {
		0%, 100% { box-shadow: 0 5px 25px rgba(10, 31, 92, 0.4), 0 0 20px rgba(200, 16, 46, 0.2); }
		50% { box-shadow: 0 8px 35px rgba(10, 31, 92, 0.6), 0 0 35px rgba(200, 16, 46, 0.4); }
	}
	.aviso-codigo {
		font-size: 11px;
		color: rgba(255,255,255,0.6);
		margin-top: 15px;
	}
	
	/* POPUP OFERTA IMAGEN */
	.popup-oferta-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0,0,0,0.7);
		z-index: 99999;
		display: none;
		opacity: 0;
		transition: opacity 0.3s ease;
	}
	.popup-oferta-overlay.active {
		display: block;
		opacity: 1;
	}
	.popup-oferta-imagen {
		position: fixed;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%) scale(0.8);
		z-index: 100000;
		display: none;
		opacity: 0;
		transition: all 0.3s ease;
		max-width: 95%;
		max-height: 95%;
	}
	@media (max-width: 991px) {
		.popup-oferta-imagen {
			width: 95% !important;
		}
	}
	.popup-oferta-imagen.active {
		display: block;
		opacity: 1;
		transform: translate(-50%, -50%) scale(1);
	}
	.popup-oferta-link {
		display: block;
		cursor: pointer;
	}
	.popup-oferta-link img {
		max-width: 450px;
		max-height: 80vh;
		border-radius: 12px;
		box-shadow: 0 15px 50px rgba(0,0,0,0.5);
	}
	.popup-oferta-cerrar {
		position: absolute;
		top: -20px;
		right: -20px;
		width: 42px;
		height: 42px;
		background: #C8102E;
		color: #fff;
		font-size: 26px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		cursor: pointer;
		transition: all 0.3s ease;
		z-index: 10;
		border: 3px solid #fff;
	}
	.popup-oferta-cerrar:hover {
		background: #a00d24;
		transform: rotate(90deg) scale(1.1);
	}
	
	/* POPUP OFERTA CARRUSEL */
	.popup-oferta-container {
		background: #fff;
		border-radius: 20px;
		padding: 30px;
		box-shadow: 0 25px 80px rgba(0,0,0,0.5);
		border: 4px solid #0A1F5C;
		transition: background 0.5s ease;
		max-width: 90vw;
	}
	.popup-oferta-titulo {
		text-align: center;
		margin-bottom: 25px;
	}
	.popup-oferta-titulo span {
		background: #0A1F5C;
		color: #FFD700;
		padding: 15px 40px;
		border-radius: 10px;
		font-size: 22px;
		font-weight: 800;
		font-family: 'Montserrat', sans-serif;
		letter-spacing: 2px;
	}
	.popup-oferta-carrusel {
		position: relative;
		overflow: hidden;
		border-radius: 15px;
	}
	.popup-oferta-slides {
		display: flex;
		transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
	}
	.popup-oferta-slide {
		min-width: 100%;
		display: flex;
		justify-content: center;
		align-items: center;
	}
	.popup-oferta-slide img {
		width: 100%;
		max-width: 900px;
		height: 500px;
		object-fit: cover;
		border-radius: 15px;
		box-shadow: 0 15px 50px rgba(0,0,0,0.4);
		display: block;
	}
	.popup-oferta-slide a {
		display: block;
		width: 100%;
	}
	.popup-oferta-nav {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 50px;
		height: 50px;
		background: rgba(10, 31, 92, 0.9);
		color: #fff;
		border: none;
		border-radius: 50%;
		font-size: 24px;
		cursor: pointer;
		transition: all 0.3s ease;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.popup-oferta-nav:hover {
		background: #0A1F5C;
		transform: translateY(-50%) scale(1.1);
	}
	.popup-oferta-prev {
		left: 15px;
	}
	.popup-oferta-next {
		right: 15px;
	}
	
	/* RESPONSIVE POPUP OFERTA CARRUSEL */
	@media (max-width: 991px) {
		.popup-oferta-container {
			padding: 20px;
			max-width: 95vw;
		}
		.popup-oferta-titulo span {
			font-size: 18px;
			padding: 12px 30px;
		}
		.popup-oferta-slide img {
			height: 380px;
		}
	}
	@media (max-width: 576px) {
		.popup-oferta-container {
			padding: 15px;
		}
		.popup-oferta-titulo span {font-size: 14px;
			padding: 10px 20px;
		}
		.popup-oferta-slide img {
			height: 280px;
		}
		.popup-oferta-nav {
			width: 40px;
			height: 40px;
			font-size: 18px;
		}
	}
	.popup-oferta-dots {
		text-align: center;
		margin-top: 20px;
	}
	.popup-oferta-dots .dot {
		display: inline-block;
		width: 12px;
		height: 12px;
		background: #ccc;
		border-radius: 50%;
		margin: 0 6px;
		cursor: pointer;
		transition: all 0.3s;
		border: 2px solid transparent;
	}
	.popup-oferta-dots .dot.active {
		background: #0A1F5C;
		transform: scale(1.3);
		border-color: #FFD700;
	}
	</style>



	<script type="module" src="https://cdn.jsdelivr.net/npm/@justinribeiro/lite-youtube@1/lite-youtube.min.js"></script>

	<style>
	/* ═══════════════════════════════════════════
	   ESTILOS INDEX 2 — BANNER, NAV, CARDS, etc.
	   ═══════════════════════════════════════════ */

	/* --- Reset & Base --- */
	* { box-sizing: border-box; margin: 0; padding: 0; }
	body { font-family: 'Poppins','Inter',sans-serif; color: #1A1A2E; background: #fff; overflow-x: hidden; }
	.inner-wrap { max-width: 1200px; margin: 0 auto; padding: 0 20px; }

	/* ══ BANNER PÚRPURA ══ */
	.banner-purpura { background:#5044c2; color:#fff; padding:12px 0; font-family:'Montserrat',sans-serif; position:relative; z-index:1100; }
	.contenido-banner-purpura { display:flex; justify-content:space-evenly; align-items:center; gap:20px; max-width:1200px; margin:0 auto; padding:0 20px; }
	.banner-item { display:flex; align-items:center; gap:12px; text-align:left; }
	.banner-icon img { width:32px; height:auto; filter:brightness(0) invert(1); }
	.banner-text b { display:block; font-size:13px; line-height:1.2; }
	.banner-text span { font-size:11px; font-weight:400; opacity:.9; }
	.highlight-yellow { color:#FFD700; }
	.btn-cotizar { background:#FFD700; color:#5044c2!important; padding:8px 20px; border-radius:6px; font-weight:800; text-decoration:none; font-size:13px; display:flex; align-items:center; gap:8px; transition:transform .2s; box-shadow:0 3px 0 #ccac00; }
	.btn-cotizar:hover { transform:translateY(-2px); background:#ffdb1f; }
	@media(max-width:991px){ .banner-purpura{display:none!important;} }

	/* ══ NAVBAR ══ */
	.rc-navbar { background:#fff!important; box-shadow:0 2px 12px rgba(0,0,0,.08); position:sticky; top:0; z-index:1050; padding:6px 0; }
	.rc-logo { height:42px; width:auto; }
	.rc-navbar .nav-link { font-family:'Montserrat',sans-serif; font-size:13px; font-weight:700; color:#0A1F5C!important; padding:8px 12px; }
	.rc-navbar .nav-link:hover { color:#C8102E!important; }
	.rc-navbar .dropdown-menu { border:none; box-shadow:0 8px 24px rgba(0,0,0,.1); border-radius:10px; }
	.rc-navbar .dropdown-item { font-family:'Poppins',sans-serif; font-size:13px; padding:8px 18px; }
	.rc-navbar .dropdown-item:hover { background:#0A1F5C; color:#fff; }
	.rc-buttons { display:flex; gap:8px; flex-shrink:0; }
	.rc-buttons a { border-radius:50px; padding:8px 18px; font-size:13px; font-weight:700; font-family:'Montserrat',sans-serif; display:flex; align-items:center; gap:5px; text-decoration:none; color:#fff; transition:transform .2s; }
	.rc-buttons a:hover { transform:translateY(-1px); }
	.btn-wsp { background:#25D366; }
	.btn-aula { background:#136EF0; }
	.btn-tienda { background:#FF044D; }

	/* ══ CAROUSEL ══ */
	.slidem { min-height:480px; background-size:cover; background-position:center; background-repeat:no-repeat; display:block; }
	.slide-1 { background-image:url('./img/slider/fondonavidad.webp'); }
	.slide-2 { background-image:url('./img/slider/bg-fondo-7.webp'); }
	.slide-3 { background-image:url('./img/slider/fondo-2x1-curso.png'); }
	@media(min-width:992px){ .slidem{min-height:540px;} }
	@media(max-width:768px){ .slide-1{background-image:url('./img/slider/slide1-mobile.webp');} .slidem{min-height:340px;} }
	.carousel-control-prev,.carousel-control-next { width:50px; opacity:.7; }

	/* ══ SECCIÓN CURSOS ══ */
	.seccion-titulo { text-align:center; padding:50px 20px 10px; }
	.seccion-titulo h2 { font-family:'Poppins',sans-serif; font-size:32px; font-weight:700; color:#0A1F5C; }
	.seccion-titulo p { font-family:'Poppins',sans-serif; font-size:15px; color:#666; margin-top:8px; }

	/* Tabs */
	.filtro-tabs { display:flex; justify-content:center; gap:2px; margin:25px auto 35px; max-width:1200px; border:none; border-radius:8px; overflow:hidden; background:#0A1F5C; padding:3px; }
	.filtro-tab { flex:1; padding:10px 15px; text-align:center; font-family:'Montserrat',sans-serif; font-size:13px; font-weight:700; color:#fff; background:transparent; cursor:pointer; border:none; border-radius:6px; transition:all .3s ease; }
	.filtro-tab:last-child { border-right:none; }
	.filtro-tab:hover { background:rgba(255,255,255,.15); }
	.filtro-tab.active { background:#fff; color:#0A1F5C; }

	/* Grid */
	.cursos-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:28px; max-width:1200px; margin:0 auto; padding:0 20px 50px; }

	/* Card */
	.curso-card { background:#E9E9E9; border-radius:14px; overflow:hidden; box-shadow:0 4px 20px rgba(0,0,0,.08); transition:transform .3s,box-shadow .3s; display:flex; flex-direction:column; }
	.curso-card:hover { transform:translateY(-4px); box-shadow:0 8px 30px rgba(0,0,0,.14); }
	.curso-card.proximo-iniciar { border:3px solid #FFD700; box-shadow:0 0 20px rgba(255,215,0,.5); animation: pulso-dorado 2s infinite; }
	.curso-card__img { position:relative; width:100%; aspect-ratio:16/12; overflow:hidden; }
	.curso-card__img img { width:100%; height:100%; object-fit:cover; display:block; }
	.curso-card__body { padding:16px 18px 20px; display:flex; flex-direction:column; gap:10px; flex:1; }
	.curso-card__badges { display:flex; justify-content:space-between; align-items:center; gap:8px; }
	.badge-tipo { font-family:'Montserrat',sans-serif; font-size:10px; font-weight:800; color:#fff; padding:5px 10px; border-radius:4px; text-transform:uppercase; background:#03206A; }
	.badge-dcto { font-family:'Montserrat',sans-serif; font-size:11px; font-weight:800; color:#fff; background:#FF044D; padding:5px 10px; border-radius:4px; }
	.curso-card__info { display:flex; justify-content:space-between; gap:10px; }
	.info-item { display:flex; align-items:center; gap:6px; font-family:'Poppins',sans-serif; font-size:14px; color:#444; }
	.info-item i { font-size:16px; color:#0A1F5C; }
	.info-item strong { font-weight:700; }
	.curso-card__extra { display:flex; justify-content:space-between; align-items:center; gap:8px; margin-top:2px; }
	.tag-envivo { display:inline-flex; align-items:center; gap:5px; font-family:'Montserrat',sans-serif; font-size:13px; font-weight:700; color:#C8102E; }
	.tag-envivo i { font-size:10px; }
	.tag-duracion { display:inline-flex; align-items:center; gap:5px; font-family:'Montserrat',sans-serif; font-size:11px; font-weight:700; color:#C8102E; }
	.tag-duracion i { font-size:8px; }
	.tag-horas { display:inline-flex; align-items:center; gap:5px; font-family:'Poppins',sans-serif; font-size:12px; font-weight:600; color:#03206A; }
	.tag-horas strong { font-weight:700; }
	.curso-card__btn { display:block; width:100%; padding:12px; border:3px solid #0A1F5C; border-radius:8px; background:#fff; color:#0A1F5C; font-family:'Montserrat',sans-serif; font-size:13px; font-weight:800; text-align:center; text-decoration:none; cursor:pointer; transition:all .25s; margin-top:auto; }
	.curso-card__btn:hover { background:#0A1F5C; color:#fff; }
	.badge-proximo { position:absolute; top:10px; right:10px; background:#FFB800; color:#000; font-family:'Montserrat',sans-serif; font-size:10px; font-weight:800; padding:5px 10px; border-radius:4px; z-index:2; }
	.curso-card.inicia-hoy .badge-proximo { display: none; }
	@keyframes pulso-dorado { 0%{box-shadow:0 0 0 0 rgba(255,215,0,.7)} 50%{box-shadow:0 0 20px 8px rgba(255,215,0,.35)} 100%{box-shadow:0 0 0 0 rgba(255,215,0,.7)} }
	@keyframes parpadeo-rojo { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
	.proximo-inicio-animado { animation:pulso-dorado 2s infinite; }
	.tag-envivo i { font-size:8px; animation: parpadeo-rojo 1.5s ease-in-out infinite; }
	
	.curso-card { position: relative; }
	.curso-card__img img { transition: filter 0.3s ease; }
	
	.sticker-progreso, .sticker-inicia-hoy { display: none; }
	
	.curso-card.ya-iniciado .sticker-progreso {
		display: block;
		position: absolute;
		top: 25px;
		right: -35px;
		background: #6c757d;
		color: #fff;
		font-family: 'Montserrat',sans-serif;
		font-size: 9px;
		font-weight: 800;
		padding: 4px 30px;
		transform: rotate(45deg);
		z-index: 10;
		letter-spacing: 0.5px;
	}
	.curso-card.ya-iniciado .curso-card__img img { filter: grayscale(100%); }
	
	.curso-card.inicia-hoy .sticker-inicia-hoy {

		display: block;

		position: absolute;

		top: 25px;

		right: -35px;

		background: #FF044D;

		color: #fff;

		font-family: 'Montserrat',sans-serif;

		font-size: 9px;

		font-weight: 800;

		padding: 4px 30px;

		transform: rotate(45deg);

		z-index: 10;

		letter-spacing: 0.5px;

		animation: pulse-rojo 1s ease-in-out infinite, pulso-dorado 2s infinite;

	}
	/* Botones ver más */
	.seccion-botones { display:flex; justify-content:center; gap:20px; padding:0 20px 60px; flex-wrap:wrap; }
	.btn-ver-mas { font-family:'Montserrat',sans-serif; font-size:14px; font-weight:700; padding:14px 30px; border-radius:8px; border:none; cursor:pointer; text-decoration:none; color:#fff; transition:all .3s; }
	.btn-ver-mas.cursos { background:#0A1F5C; }
	.btn-ver-mas.cursos:hover { background:#0d2a75; }
	.btn-ver-mas.diplomas { background:#C8102E; }
	.btn-ver-mas.diplomas:hover { background:#a00d24; }

	/* Optimizaciones de rendimiento GPU */
	.curso-card, .popup-compras, .icono-oferta-flotante, .overlay-oferta, .cursos-hover-container {
		transform: translateZ(0);
		-webkit-transform: translateZ(0);
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
	}
	.curso-card {
		will-change: transform, box-shadow;
	}

	/* ══ RESPONSIVE ══ */
	@media(max-width:991px){
		.cursos-grid{grid-template-columns:repeat(2,1fr);gap:20px;}
		.filtro-tabs{max-width:95%;}
		.filtro-tab{font-size:11px;padding:10px 6px;}
		.seccion-titulo h2{font-size:24px;}
		.rc-buttons{flex-wrap:wrap;justify-content:center;}
	}
	@media(max-width:576px){
		.cursos-grid{grid-template-columns:1fr;gap:18px;padding:0 14px 40px;}
		.filtro-tabs{flex-wrap:nowrap;overflow-x:auto;border-radius:8px;}
		.filtro-tab{white-space:nowrap;font-size:11px;padding:10px 12px;flex:0 0 auto;}
		.seccion-botones{flex-direction:column;align-items:center;}
		.grid-programas{gap:14px;}
		.card-programa{width:140px;padding:20px 14px;}
		/* Reducir animaciones en mobile para mejor rendimiento */
		.curso-card { transition: transform .2s, box-shadow .2s; }
		.popup-compras { animation: popupCompraEntra .2s ease; }
	}
	
	/* ══ BANNER DE COOKIES ══ */
	.cookie-banner {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		background: linear-gradient(135deg, #0A1F5C 0%, #03206A 100%);
		color: #fff;
		padding: 20px;
		z-index: 2147483647;
		display: none;
		box-shadow: 0 -5px 30px rgba(0,0,0,0.3);
		font-family: 'Poppins', sans-serif;
	}
	.cookie-banner.show { display: block; animation: slideUp 0.5s ease; }
	@keyframes slideUp {
		from { transform: translateY(100%); opacity: 0; }
		to { transform: translateY(0); opacity: 1; }
	}
	.cookie-content {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 15px;
	}
	.cookie-text {
		flex: 1;
		min-width: 280px;
	}
	.cookie-text p {
		font-size: 14px;
		margin: 0;
		line-height: 1.5;
	}
	.cookie-text a {
		color: #FFD700;
		text-decoration: underline;
	}
	.cookie-buttons {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
	}
	.cookie-btn {
		padding: 10px 20px;
		border-radius: 6px;
		font-size: 13px;
		font-weight: 700;
		cursor: pointer;
		border: none;
		transition: all 0.3s ease;
		font-family: 'Poppins', sans-serif;
	}
	.cookie-btn-accept {
		background: #25D366;
		color: #fff;
	}
	.cookie-btn-accept:hover { background: #20b858; transform: scale(1.05); }
	.cookie-btn-necessary {
		background: transparent;
		color: #fff;
		border: 2px solid #fff;
	}
	.cookie-btn-necessary:hover { background: rgba(255,255,255,0.1); }
	.cookie-btn-settings {
		background: #C8102E;
		color: #fff;
	}
	.cookie-btn-settings:hover { background: #a00d24; }
	
	/* Panel de ajustes de cookies */
	.cookie-settings-panel {
		position: fixed;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%) scale(0.9);
		background: #fff;
		border-radius: 15px;
		padding: 30px;
		max-width: 500px;
		width: 90%;
		z-index: 2147483647;
		display: none;
		box-shadow: 0 20px 60px rgba(0,0,0,0.5);
	}
	.cookie-settings-panel.show {
		display: block;
		animation: popIn 0.3s ease;
	}
	@keyframes popIn {
		from { transform: translate(-50%, -50%) scale(0.8); opacity: 0; }
		to { transform: translate(-50%, -50%) scale(1); opacity: 1; }
	}
	.cookie-settings-overlay {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(0,0,0,0.6);
		z-index: 2147483646;
		display: none;
	}
	.cookie-settings-overlay.show { display: block; }
	.cookie-settings-panel h3 {
		color: #0A1F5C;
		font-size: 20px;
		margin-bottom: 20px;
		font-weight: 800;
	}
	.cookie-option {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 15px 0;
		border-bottom: 1px solid #eee;
	}
	.cookie-option:last-child { border-bottom: none; }
	.cookie-option label {
		font-weight: 600;
		color: #333;
	}
	.cookie-option input[type="checkbox"] {
		width: 20px;
		height: 20px;
		accent-color: #0A1F5C;
	}
	.cookie-settings-buttons {
		display: flex;
		gap: 10px;
		margin-top: 20px;
	}
	.cookie-settings-buttons .cookie-btn {
		flex: 1;
		text-align: center;
	}
	</style>
</head>
