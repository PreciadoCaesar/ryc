<!-- JS del proyecto: Notificaciones desde JSON -->
<script>
(function() {
    var notificacionesData = [];
    var indiceActual = 0;
    
    // Cargar notificaciones desde JSON
    fetch('./notificaciones.json')
        .then(function(response) { 
            return response.json(); 
        })
        .then(function(data) {
            notificacionesData = data;
            if (notificacionesData.length > 0) {
                iniciarNotificaciones();
            }
        })
        .catch(function(error) {
            // Fallback: datos por defecto si no carga el JSON
            notificacionesData = [
                {"nombre": "NATHALY MELLANIE RIOS MENDOZA", "curso": "CURSO DE GESTIÓN PÚBLICA", "tiempo": "hace 3 min"},
                {"nombre": "KEVIN ITALO VELASQUEZ MENDOZA", "curso": "SISTEMA NACIONAL DE PROGRAMACIÓN", "tiempo": "hace 6 min"},
                {"nombre": "ADRIANA VALERIA NAZAR VARGAYA", "curso": "GOBIERNO DIGITAL", "tiempo": "hace 9 min"},
                {"nombre": "CARMEN SOLEDAD SOLANO CHUMPITAZ", "curso": "SIAF", "tiempo": "hace 12 min"},
                {"nombre": "NURITH JIMÉNEZ ORTIZ", "curso": "PRESUPUESTO PUBLICO", "tiempo": "hace 15 min"},
                {"nombre": "LESLYEE KELY MONTELUISA GARCIA", "curso": "GESTIÓN PÚBLICA", "tiempo": "hace 18 min"},
                {"nombre": "IVAN ERICK CELSO GÓMEZ AGUIRRE", "curso": "SIAF SP Y RP", "tiempo": "hace 21 min"},
                {"nombre": "SELKY SANDY DELGADO SÁNCHEZ", "curso": "SIGA MEF", "tiempo": "hace 24 min"},
                {"nombre": "SILVIA PATRICIA CAMPERO ALVARADO", "curso": "CONTRATACIONES PÚBLICAS", "tiempo": "hace 27 min"},
                {"nombre": "JIMENA DEL CARMEN MIRANDA LUNA", "curso": "SIGA MEF", "tiempo": "hace 30 min"}
            ];
            iniciarNotificaciones();
        });
    
    function iniciarNotificaciones() {
        var container = document.createElement('div');
        container.className = 'popup-compras';
        container.id = 'popup-compras';
        container.innerHTML = 
            '<span class="cerrar" onclick="cerrarNotificacion()">&times;</span>' +
            '<div class="contenido">' +
                '<div class="icono"><i class="fas fa-check"></i></div>' +
                '<div class="texto">' +
                    '<div class="nombre"></div>' +
                    '<div class="curso"></div>' +
                    '<div class="badge"><i class="fas fa-graduation-cap"></i>Inscrito exitosamente</div>' +
                '</div>' +
            '</div>';
        document.body.appendChild(container);
        
        setTimeout(mostrarNotificacion, 2000);
    }
    
    function mostrarNotificacion() {
        if (notificacionesData.length === 0) return;
        
        var container = document.getElementById('popup-compras');
        if (!container) return;
        
        var notif = notificacionesData[indiceActual];
        indiceActual = (indiceActual + 1) % notificacionesData.length;
        
        container.querySelector('.nombre').textContent = notif.nombre;
        container.querySelector('.curso').textContent = notif.curso;
        
        container.classList.remove('ocultar');
        container.classList.add('show');
        
        setTimeout(function() {
            container.classList.add('ocultar');
            setTimeout(function() {
                container.classList.remove('show');
                container.classList.remove('ocultar');
                var tiempoEspera = Math.floor(Math.random() * 11000) + 15000;
                setTimeout(mostrarNotificacion, tiempoEspera);
            }, 400);
        }, 5000);
    }
    
    window.cerrarNotificacion = function() {
        var container = document.getElementById('popup-compras');
        if (container) {
            container.classList.add('ocultar');
            setTimeout(function() {
                container.classList.remove('show');
                container.classList.remove('ocultar');
                var tiempoEspera = Math.floor(Math.random() * 11000) + 15000;
                setTimeout(mostrarNotificacion, tiempoEspera);
            }, 400);
        }
    };
})();
</script>

<!-- Viewing Counts - Personas viendo este curso -->
<script>
(function() {
    var viewingData = [];
    for (var i = 0; i < 50; i++) {
        viewingData.push(Math.floor(Math.random() * 30) + 10);
    }
    
    function initViewingCounts() {
        var cards = document.querySelectorAll('.curso-card__img');
        cards.forEach(function(imgContainer) {
            if (!imgContainer.querySelector('.viewing-count')) {
                var viewers = viewingData[Math.floor(Math.random() * viewingData.length)];
                var badge = document.createElement('span');
                badge.className = 'viewing-count';
                badge.innerHTML = '<span style="color:#4CAF50;">●</span> ' + viewers + ' viendo esto';
                imgContainer.appendChild(badge);
            }
        });
    }
    
    // Ejecutar después de que el DOM esté listo y después de ordenar cursos
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(initViewingCounts, 100);
        });
    } else {
        setTimeout(initViewingCounts, 100);
    }
})();
</script>

<!-- POPUP OFERTA CARRUSEL -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    var popup = document.getElementById('popupOfertaImagen');
    var overlay = document.getElementById('popupOfertaOverlay');
    var cerrar = document.getElementById('cerrarPopupOferta');
    var container = document.getElementById('popupOfertaContainer');
    var slidesContainer = document.getElementById('popupOfertaSlides');
    var dotsContainer = document.getElementById('popupOfertaDots');
    var prevBtn = document.getElementById('popupOfertaPrev');
    var nextBtn = document.getElementById('popupOfertaNext');
    
    var delayMs = 2000;
    var currentSlide = 0;
    var slides = [];
    var autoSlideInterval;
    
    // Cursos que inician hoy - PRIMERO
    var items = [];
    var cursosInicianHoy = document.querySelectorAll('.curso-card.inicia-hoy');
    cursosInicianHoy.forEach(function(card) {
        var img = card.querySelector('.curso-card__img img');
        var btn = card.querySelector('.curso-card__btn');
        if (img && btn) {
            items.push({
                src: img.src,
                link: btn.href,
                alt: 'Curso que inicia hoy'
            });
        }
    });
    
    // Luego la promoción
    items.push({
        src: './img/imagenOferta2.webp',
        link: 'https://rc-consulting.org/online/Preparacion%20intensiva%20para%20el%20examen%20de%20Certificacion%20OECE%202026,%20incluye%20simulador%20del%20Examen%20OECE/',
        alt: 'Promoción'
    });
    
    // Crear slides
    items.forEach(function(item, index) {
        var slide = document.createElement('div');
        slide.className = 'popup-oferta-slide';
        slide.innerHTML = '<a href="' + item.link + '" target="_blank"><img src="' + item.src + '" alt="' + item.alt + '"></a>';
        slidesContainer.appendChild(slide);
        
        // Crear dot
        var dot = document.createElement('span');
        dot.className = 'dot' + (index === 0 ? ' active' : '');
        dot.addEventListener('click', function() {
            goToSlide(index);
        });
        dotsContainer.appendChild(dot);
    });
    
    slides = slidesContainer.querySelectorAll('.popup-oferta-slide');
    
    // Cambiar título según si hay cursos que inician hoy
    var tituloEl = document.getElementById('popupOfertaTitulo');
    var cursosInicianHoyCount = document.querySelectorAll('.curso-card.inicia-hoy').length;
    if (cursosInicianHoyCount > 0) {
        tituloEl.textContent = '¡INICIA HOY!';
    }
    
    // Ocultar navegación si solo hay 1 slide
    if (slides.length <= 1) {
        prevBtn.style.display = 'none';
        nextBtn.style.display = 'none';
        dotsContainer.style.display = 'none';
    }
    
    function goToSlide(index) {
        currentSlide = index;
        slidesContainer.style.transform = 'translateX(-' + (currentSlide * 100) + '%)';
        
        var dots = dotsContainer.querySelectorAll('.dot');
        dots.forEach(function(dot, i) {
            dot.classList.toggle('active', i === currentSlide);
        });
    }
    
    function nextSlide() {
        goToSlide((currentSlide + 1) % slides.length);
    }
    
    function prevSlide() {
        goToSlide((currentSlide - 1 + slides.length) % slides.length);
    }
    
    // Navegación
    nextBtn.addEventListener('click', function() {
        nextSlide();
        resetAutoSlide();
    });
    
    prevBtn.addEventListener('click', function() {
        prevSlide();
        resetAutoSlide();
    });
    
    function startAutoSlide() {
        autoSlideInterval = setInterval(nextSlide, 5000);
    }
    
    function resetAutoSlide() {
        clearInterval(autoSlideInterval);
        startAutoSlide();
    }
    
    // Obtener color dominante
    function obtenerColorDominante(imgEl, callback) {
        var canvas = document.createElement('canvas');
        var ctx = canvas.getContext('2d');
        canvas.width = 50;
        canvas.height = 50;
        ctx.drawImage(imgEl, 0, 0, 50, 50);
        
        var data = ctx.getImageData(0, 0, 50, 50).data;
        var r = 0, g = 0, b = 0, count = 0;
        
        for (var i = 0; i < data.length; i += 4) {
            if (data[i+3] > 128) {
                r += data[i];
                g += data[i+1];
                b += data[i+2];
                count++;
            }
        }
        
        if (count > 0) {
            r = Math.floor(r / count);
            g = Math.floor(g / count);
            b = Math.floor(b / count);
            
            if (r + g + b < 200) {
                r = Math.min(255, r + 60);
                g = Math.min(255, g + 60);
                b = Math.min(255, b + 60);
            }
            
            callback('rgb(' + r + ',' + g + ',' + b + ')');
        }
    }var promoImg = document.querySelector('.popup-oferta-slide img');
    if (promoImg && promoImg.complete) {
        obtenerColorDominante(promoImg, function(color) {
            container.style.background = 'linear-gradient(135deg, ' + color + ' 0%, #fff 50%, ' + color + ' 100%)';
        });
    } else if (promoImg) {
        promoImg.onload = function() {
            obtenerColorDominante(promoImg, function(color) {
                container.style.background = 'linear-gradient(135deg, ' + color + ' 0%, #fff 50%, ' + color + ' 100%)';
            });
        };
    }
    
    function mostrarPopup() {
        popup.classList.add('active');
        overlay.classList.add('active');
        startAutoSlide();
    }
    
    function cerrarPopup() {
        popup.classList.remove('active');
        overlay.classList.remove('active');
        clearInterval(autoSlideInterval);
    }
    
    setTimeout(mostrarPopup, delayMs);
    
    cerrar.addEventListener('click', cerrarPopup);
    overlay.addEventListener('click', cerrarPopup);
    
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            cerrarPopup();
        }
    });
});
</script>

<!-- SCRIPT OFERTA FLOTANTE -->
<script>
function getCookie(name) {
	var value = "; " + document.cookie;
	var parts = value.split("; " + name + "=");
	if (parts.length === 2) return parts.pop().split(";").shift();
}

function setCookie(name, value, days) {
	var expires = "";
	if (days) {
		var date = new Date();
		date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
		expires = "; expires=" + date.toUTCString();
	}
	document.cookie = name + "=" + (value || "") + expires + "; path=/; SameSite=Lax";
}

document.addEventListener('DOMContentLoaded', function() {
(function() {
	var icono = document.getElementById('iconoOferta');
	var overlay = document.getElementById('overlayOferta');
	var container = document.getElementById('cursosHoverContainer');
	var grid = document.getElementById('cursosHoverGrid');
	var modalResultado = document.getElementById('modalResultadoOferta');
	var cerrarResultado = document.getElementById('cerrarResultado');
	var codigoDisplay = document.getElementById('codigoDisplay');
	var btnVerCurso = document.getElementById('btnVerCurso');
	
	var ofertaMostrada = localStorage.getItem('ofertaMostrada');
	var cursoActual = null;
	
	function generarCodigo(nombre) {
		var prefix = nombre.substring(0, 4).toUpperCase().replace(/[^A-Z]/g, 'X');
		var año = new Date().getFullYear().toString().slice(-2);
		var random = Math.floor(Math.random() * 900) + 100;
		return prefix + año + random;
	}
	
	// Obtener cursos próximos de la página
	function obtenerCursosProximos() {
		var cursos = [];
		// Primero buscar con la categoría específica
		var cards = document.querySelectorAll('.curso-card[data-category*="proximos-inicios"]');
		// Si no hay cursos próximos, buscar cualquier curso
		if (cards.length === 0) {
			cards = document.querySelectorAll('.curso-card');
		}
		// Tomar todos los cursos disponibles
		var cardsArray = Array.from(cards);
		cardsArray.forEach(function(card) {
			var img = card.querySelector('.curso-card__img img');
			var btn = card.querySelector('.curso-card__btn');
			var fecha = card.querySelector('.info-item span');
			
			var nombreEl = card.querySelector('.badge-tipo');
			var nombre = nombreEl ? nombreEl.textContent.trim() : 'Curso';
			
			cursos.push({
				nombre: nombre,
				imagen: img ? img.src : '',
				fecha: fecha ? fecha.textContent.trim() : '',
				link: btn ? btn.href : '#'
			});
		});
		return cursos;
	}
	
	// Renderizar cursos en el grid
	var cursosData = obtenerCursosProximos();
	cursosData.forEach(function(curso) {
		var item = document.createElement('div');
		item.className = 'curso-hover-item';
		item.innerHTML = 
			'<img src="' + curso.imagen + '" alt="' + curso.nombre + '">' +
			'<div class="curso-hover-info">' +
				'<h4>' + curso.nombre + '</h4>' +
				'<div class="fecha">' + curso.fecha + '</div>' +
			'</div>' +
			'<div class="curso-hover-overlay"><span>¡Obtén descuento!</span></div>';
		
		item.addEventListener('click', function() {
			cursoActual = curso;
			var codigo = generarCodigo(curso.nombre);
			codigoDisplay.textContent = codigo;
			btnVerCurso.href = curso.link;
			container.classList.remove('active');
			setTimeout(function() {
				container.style.display = 'none';
				modalResultado.classList.add('active');
				var contenido = modalResultado.querySelector('.resultado-contenido');
				if (contenido) {
					setTimeout(function() {
						contenido.classList.add('mostrar');
					}, 100);
				}
			}, 200);
		});
		
		grid.appendChild(item);
	});
	
	// Función para mostrar la oferta del regalo (se llama después de aceptar cookies)
	function initGiftOffer() {
		var consent = getCookie('cookieConsent');
		
		if (!consent || consent === 'necessary') {
			return;
		}
		
		var ofertaGuardada = getCookie('rcSession');
		
		// 49% de probabilidad
		if (!ofertaGuardada && Math.random() < 0.49) {
			icono.style.display = 'flex';
			setCookie('rcSession', 'true', 1);
		}
	}
	
	// Animacion para abrir
	icono.addEventListener('click', function() {
		overlay.style.display = 'block';
		overlay.classList.add('active');
		container.style.display = 'block';
		
		// Solo mostrar estela una vez
		var yaVioEstela = getCookie('rcEstela');
		if (!yaVioEstela) {
			container.classList.add('con-estela');
			setCookie('rcEstela', 'true', 30);
		}
		
		setTimeout(function() {
			container.classList.add('active');
		}, 50);
	});
	
	// Cerrar
	function cerrarOferta() {
		modalResultado.classList.remove('active');
		container.classList.remove('active');
		container.classList.remove('con-estela');
		overlay.classList.remove('active');
		var contenido = modalResultado.querySelector('.resultado-contenido');
		if (contenido) {
			contenido.classList.remove('mostrar');
		}
		setTimeout(function() {
			container.style.display = 'none';
			overlay.style.display = 'none';
		}, 300);
	}
	
	overlay.addEventListener('click', cerrarOferta);
	cerrarResultado.addEventListener('click', function(e) {
		e.stopPropagation();
		cerrarOferta();
	});
	
	// Hacer funcion accesible globalmente para botones de cookies
	window.initGiftOffer = initGiftOffer;
})();
});
</script>

<!-- BANNER DE COOKIES -->
<div class="cookie-banner" id="cookieBanner">
	<div class="cookie-content">
		<div class="cookie-text">
			<p><i class="fas fa-cookie-bite"></i> <strong>Usamos cookies</strong> para mejorar tu experiencia en nuestro sitio web.</p>
			<p style="font-size:12px;margin-top:5px;opacity:0.9;"><i class="fas fa-circle" style="font-size:8px;color:#0A1F5C;"></i> <strong>Necesarias:</strong> funcionamiento basico | <i class="fas fa-chart-bar"></i> <strong>Analytics:</strong> estadisticas de visita | <i class="fas fa-bullhorn"></i> <strong>Marketing:</strong> promociones personalizadas</p>
			<p style="font-size:11px;margin-top:5px;"><a href="politica-cookies.html" target="_blank" style="color:#FFD700;text-decoration:underline;"><i class="fas fa-external-link-alt"></i> Ver Politica de Cookies</a></p>
		</div>
		<div class="cookie-buttons">
			<button class="cookie-btn cookie-btn-accept" onclick="acceptAllCookies()"><i class="fas fa-check"></i> Aceptar todas</button>
			<button class="cookie-btn cookie-btn-necessary" onclick="acceptNecessaryCookies()"><i class="fas fa-cookie"></i> Solo necesarias</button>
			<button class="cookie-btn cookie-btn-settings" onclick="showCookieSettings()"><i class="fas fa-sliders-h"></i> Ajustes</button>
		</div>
	</div>
</div>

<!-- PANEL DE AJUSTES DE COOKIES -->
<div class="cookie-settings-overlay" id="cookieSettingsOverlay" onclick="hideCookieSettings()"></div>
<div class="cookie-settings-panel" id="cookieSettingsPanel">
	<h3><i class="fas fa-sliders-h"></i> Configuracion de Cookies</h3>
	<p style="font-size:13px;color:#666;margin-bottom:15px;">Selecciona que cookies quieres que utilicemos:</p>
	<div class="cookie-option">
		<div>
			<label style="display:block;font-weight:700;color:#0A1F5C;"><i class="fas fa-circle" style="font-size:10px;color:#0A1F5C;"></i> Necesarias</label>
			<span style="font-size:11px;color:#888;">Cookies esenciales para el funcionamiento del sitio. Siempre activas.</span>
		</div>
		<input type="checkbox" checked disabled>
	</div>
	<div class="cookie-option">
		<div>
			<label style="display:block;font-weight:700;color:#0A1F5C;"><i class="fas fa-chart-bar"></i> Analytics</label>
			<span style="font-size:11px;color:#888;">Nos ayudan a entender como navegas por nuestro sitio (Google Analytics).</span>
		</div>
		<input type="checkbox" id="cookieAnalytics">
	</div>
	<div class="cookie-option">
		<div>
			<label style="display:block;font-weight:700;color:#0A1F5C;"><i class="fas fa-bullhorn"></i> Marketing</label>
			<span style="font-size:11px;color:#888;">Usadas para mostrarte promociones personalizadas en redes sociales.</span>
		</div>
		<input type="checkbox" id="cookieMarketing">
	</div>
	<div class="cookie-settings-buttons">
		<button class="cookie-btn cookie-btn-accept" onclick="saveCookieSettings()"><i class="fas fa-save"></i> Guardar preferencias</button>
		<button class="cookie-btn cookie-btn-necessary" onclick="hideCookieSettings()"><i class="fas fa-times"></i> Cancelar</button>
	</div>
	<p style="font-size:11px;color:#888;margin-top:15px;text-align:center;">
		<a href="politica-cookies.html" target="_blank" style="color:#0A1F5C;"><i class="fas fa-external-link-alt"></i> Ver Politica de Cookies completa</a>
	</p>
</div>

<!-- SCRIPT DE COOKIES -->
<script>
function showCookieBanner() {
	var consent = getCookie('cookieConsent');
	if (!consent) {
		document.getElementById('cookieBanner').classList.add('show');
	}
}

function acceptAllCookies() {
	setCookie('cookieConsent', 'all', 30);
	setCookie('cookieAnalytics', 'true', 30);
	setCookie('cookieMarketing', 'true', 30);
	document.getElementById('cookieBanner').classList.remove('show');
	initGiftOffer();
}

function acceptNecessaryCookies() {
	setCookie('cookieConsent', 'necessary', 30);
	setCookie('cookieAnalytics', 'false', 30);
	setCookie('cookieMarketing', 'false', 30);
	document.getElementById('cookieBanner').classList.remove('show');
	initGiftOffer();
}

function showCookieSettings() {
	document.getElementById('cookieSettingsOverlay').classList.add('show');
	document.getElementById('cookieSettingsPanel').classList.add('show');
	var analytics = getCookie('cookieAnalytics');
	var marketing = getCookie('cookieMarketing');
	document.getElementById('cookieAnalytics').checked = (analytics === 'true');
	document.getElementById('cookieMarketing').checked = (marketing === 'true');
}

function hideCookieSettings() {
	document.getElementById('cookieSettingsOverlay').classList.remove('show');
	document.getElementById('cookieSettingsPanel').classList.remove('show');
}

function saveCookieSettings() {
	var analytics = document.getElementById('cookieAnalytics').checked;
	var marketing = document.getElementById('cookieMarketing').checked;
	var consent = (analytics && marketing) ? 'all' : ((!analytics && !marketing) ? 'necessary' : 'custom');
	setCookie('cookieConsent', consent, 30);
	setCookie('cookieAnalytics', analytics ? 'true' : 'false', 30);
	setCookie('cookieMarketing', marketing ? 'true' : 'false', 30);
	hideCookieSettings();
	document.getElementById('cookieBanner').classList.remove('show');
	initGiftOffer();
}

// Inicializar banner de cookies al cargar
if (document.readyState === 'loading') {
	document.addEventListener('DOMContentLoaded', showCookieBanner);
} else {
	showCookieBanner();
}
</script>

