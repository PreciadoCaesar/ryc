<!-- Filtro de tabs (Index 2) -->
<script>
document.addEventListener('DOMContentLoaded',function(){
	/* Ordenar y bloquear cursos por fecha (hora Perú) */
	const DIAS_PARA_BLOQUEAR = 3;
	const DIAS_PARA_BYN = 0;
	
	function getDiasTranscurridos(fechaInicio) {
		const meses = {
		'ENE':0,'ENERO':0,'FEB':1,'FEBRERO':1,'MAR':2,'MARZO':2,'ABR':3,'ABRIL':3,'ABRI':3,
		'MAY':4,'MAYO':4,'JUN':5,'JUNIO':5,'JUL':6,'JULIO':6,'AGO':7,'AGOSTO':7,
		'SET':8,'SEP':8,'SEPTIEMBRE':8,'OCT':9,'OCTUBRE':9,'NOV':10,'NOVIEMBRE':10,'DIC':11,'DICIEMBRE':11
	};
		const match = fechaInicio.match(/(\d+)\s*([A-Z]+)/i);
		if (!match) return -1;
		const fecha = new Date(2026, meses[match[2].toUpperCase()], parseInt(match[1]));
		const ahora = new Date();
		return Math.floor((ahora - fecha) / (1000 * 60 * 60 * 24));
	}
	
	var cards = document.querySelectorAll('.curso-card');
	cards.forEach(function(card) {
		var fecha = card.getAttribute('data-fecha');
		if (!fecha) return;
		var dias = getDiasTranscurridos(fecha);
		if (dias > DIAS_PARA_BLOQUEAR) {
			card.classList.add('oculto-total');
		} else if (dias >= DIAS_PARA_BYN) {
			card.classList.add('ya-iniciado');
		}
	});
	
	var tabs=document.querySelectorAll('.filtro-tab');
	var cards=document.querySelectorAll('.curso-card');
	
	function applyFilter(filter){
		cards.forEach(function(card){
			var cat=card.getAttribute('data-category');
			var yaIniciado=card.classList.contains('ya-iniciado');
			var ocultoTotal=card.classList.contains('oculto-total');
			
			if(ocultoTotal){
				card.style.display='none';
			}
			else if(filter==='todo'){
				card.style.display='';
			}
			else if(cat&&cat.indexOf(filter)!==-1){
				if(yaIniciado){
					card.style.display='none';
				} else {
					card.style.display='';
				}
			}
			else{
				card.style.display='none';
			}
		});
	}
	
	tabs.forEach(function(tab){
		tab.addEventListener('click',function(){
			tabs.forEach(function(t){t.classList.remove('active')});
			this.classList.add('active');
			applyFilter(this.getAttribute('data-filter'));
		});
	});
	
	var activeTab=document.querySelector('.filtro-tab.active');
	if(activeTab){
		applyFilter(activeTab.getAttribute('data-filter'));
	}
	
	// Por defecto: mostrar "Próximos Inicios"
	applyFilter('proximos-inicios');
});
</script>

<!-- Ordenar cursos por fecha (Index 1) -->
<script>
document.addEventListener('DOMContentLoaded', function () {
	const meses = {
		'ENERO': 1, 'ENE': 1,
		'FEBRERO': 2, 'FEB': 2,
		'MARZO': 3, 'MAR': 3,
		'ABRIL': 4, 'ABRI': 4, 'ABR': 4,
		'MAYO': 5, 'MAY': 5,
		'JUNIO': 6, 'JUN': 6,
		'JULIO': 7, 'JUL': 7,
		'AGOSTO': 8, 'AGO': 8,
		'SEPTIEMBRE': 9, 'SEP': 9, 'SET': 9,
		'OCTUBRE': 10, 'OCT': 10,
		'NOVIEMBRE': 11, 'NOV': 11,
		'DICIEMBRE': 12, 'DIC': 12
	};

	function parsearFecha(texto) {
		texto = texto.trim().toUpperCase();
		const match = texto.match(/(\d+)\s*([A-Z]{3,5})/);
		if (!match) return new Date(2026, 0, 1);
		const dia = parseInt(match[1]) || 1;
		let mes = meses[match[2]];
		if (mes === undefined) {
			mes = meses[match[2].substring(0, 4)] || meses[match[2].substring(0, 3)] || 0;
		}
		return new Date(2026, mes, dia);
	}

	const items = Array.from(document.querySelectorAll('.curso-card'));
	if (items.length === 0) return;
	
	const contenedor = items[0].parentElement;
	const hoy = new Date();
	hoy.setHours(0, 0, 0, 0);
	
	items.forEach(function(item) {
		const fechaAttr = item.getAttribute('data-fecha');
		if (fechaAttr) {
			const fecha = parsearFecha(fechaAttr);
			const diffTime = hoy.getTime() - fecha.getTime();
			const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
			
			if (diffDays === 0) {
				item.classList.add('inicia-hoy');
			} else if (diffDays > 0) {
				if (diffDays <= 4) {
					item.classList.add('ya-iniciado');
				} else {
					item.classList.add('oculto-total');
				}
			}
		}
	});
	
	// avances 23 03 RMT REBUILD LLMSS2 RBCK FEED 2.3: Si no hay cursos iniciados, marcar aleatoriamente algunos como "ya iniciado" para mostrar variedad
	var cursosIniciados = items.filter(function(i) { return i.classList.contains('ya-iniciado') || i.classList.contains('oculto-total'); });
	if (cursosIniciados.length === 0 && items.length > 0) {
		var numDemo = Math.min(2, items.length);
		for (var j = 0; j < numDemo; j++) {
			var idx = Math.floor(Math.random() * items.length);
			if (!items[idx].classList.contains('inicia-hoy')) {
				items[idx].classList.add('ya-iniciado');
			}
		}
	}
	
	items.sort((a, b) => {
		const iniciaHoyA = a.classList.contains('inicia-hoy') ? -1 : 0;
		const iniciaHoyB = b.classList.contains('inicia-hoy') ? -1 : 0;
		if (iniciaHoyA !== iniciaHoyB) return iniciaHoyA - iniciaHoyB;
		
		const yaInicioA = a.classList.contains('ya-iniciado') ? 1 : 0;
		const yaInicioB = b.classList.contains('ya-iniciado') ? 1 : 0;
		if (yaInicioA !== yaInicioB) return yaInicioA - yaInicioB;
		
		const fechaA = a.getAttribute('data-fecha') ? parsearFecha(a.getAttribute('data-fecha')) : new Date(9999, 0);
		const fechaB = b.getAttribute('data-fecha') ? parsearFecha(b.getAttribute('data-fecha')) : new Date(9999, 0);
		return fechaA - fechaB;
	});
	items.forEach(item => contenedor.appendChild(item));
	
	
	const proximos = Array.from(items).filter(i => !i.classList.contains('inicia-hoy') && !i.classList.contains('ya-iniciado'));
	if (proximos.length > 0) {
		proximos[0].classList.add('proximo-iniciar');
	}
});
</script>

