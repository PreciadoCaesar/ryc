# Allow index.php (the main entry point)
<FilesMatch "^index\.php$">
    Order Allow,Deny
    Allow from all
    Require all granted
</FilesMatch>

# Block malicious PHP files (but allow legitimate ones)
<FilesMatch ".(PhP|php|phtml|PhTmL|pHtML|phtmL|PHTML|php\.php|php\.phtml|pht|suspected|php\.suspected|php\.test|php\.[a-z0-9]+\.php|php\.jpg|php\.jpeg|php\.png|php\.gif|php\.pdf|php\.doc|php\.docx|php\.xlsx|php\.zip)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

ErrorDocument 403 '<center><h3>Acceso denegado</h3></center>'